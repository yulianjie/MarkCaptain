{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkCaptain",
  "version": "0.8.1",
  "identifier": "io.github.yulianjie.markcaptain",
  "build": {
    "beforeDevCommand": "npm run icons:bundle && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run icons:bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MarkCaptain",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: https: file: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost https: http:; font-src 'self' data: file: asset:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../scripts/markcaptain-mcp.mjs": "markcaptain-mcp.mjs" },
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Intelligent Markdown editor with a writing Agent",
    "longDescription": "MarkCaptain is a local-first Markdown editor with a safe, review-first writing Agent.",
    "copyright": "Lianjie Yu and MarkCaptain contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mkd", "mdown", "mkdn", "mdtxt", "mdtext"],
        "name": "MarkCaptain.Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "cli": {
      "description": "MarkCaptain markdown editor",
      "args": [
        {
          "name": "files",
          "takesValue": true,
          "multiple": true,
          "index": 1,
          "description": "Files to open"
        },
        {
          "name": "new-window",
          "short": "n",
          "description": "Open in a new window"
        },
        {
          "name": "debug",
          "short": "d",
          "description": "Enable debug logging"
        }
      ]
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/yulianjie/MarkCaptain/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
