{
  "bundle": {
    "resources": {
      "../resources/icons/md.ico": "icons/md.ico"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["windows/markdown-file-icon.wxs"],
        "componentRefs": [
          "MarkdownFileIconRegistry",
          "MarkdownCurrentUserApplicationRegistration"
        ]
      },
      "nsis": {
        "installerHooks": "windows/markdown-file-icon.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkCaptain",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ]
  }
}
